{
  "name": "sentinel-react",
  "version": "1.0.0",
  "description": "Advanced Meteorological Analysis & Predictive Systems",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-client": "cd client && npm install",
    "heroku-postbuild": "npm run install-client && npm run build",
    "build-and-start": "npm run build && npm start"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "leaflet": "^1.9.4",
    "mongodb": "^6.19.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.6.7",
    "nodemailer": "^7.0.6",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "concurrently": "^7.6.0"
  },
  "keywords": [
    "weather",
    "meteorology",
    "flood-risk",
    "nasa-power",
    "react"
  ],
  "author": "Sentinel Team",
  "license": "MIT"
}
